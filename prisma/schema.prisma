generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cafes {
  id          Int     @id @default(autoincrement())
  name        String? @unique
  location    String?
  description String?
  image_url   String?
}

model users {
  id         Int       @id @default(autoincrement())
  username   String
  email      String    @unique
  password   String
  created_at DateTime? @default(now())
}
