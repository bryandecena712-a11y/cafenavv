generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model cafes {
  id          Int     @id @default(autoincrement())
  name        String? @unique(map: "sqlite_autoindex_cafes_1")
  location    String?
  description String?
  image_url   String?
}

model users {
  id         Int       @id @default(autoincrement())
  username   String
  email      String    @unique(map: "sqlite_autoindex_users_1")
  password   String
  created_at DateTime? @default(now())
}
