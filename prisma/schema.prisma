generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cafes {
  id          Int     @id @default(autoincrement())
  name        String? @unique
  location    String?
  description String?
  image_url   String?
  products    products[]
  stories     stories[]
}

model products {
  id          Int     @id @default(autoincrement())
  cafe_id     Int
  name        String
  price       String
  description String?
  image_url   String?
  
  cafe        cafes   @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
}

model users {
  id         Int       @id @default(autoincrement())
  username   String
  email      String    @unique
  password   String
  created_at DateTime? @default(now())
  stories    stories[]
  audit_logs audit_logs[]
}

model audit_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int
  action     String
  target     String
  created_at DateTime? @default(now())
  
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model stories {
  id         Int       @id @default(autoincrement())
  user_id    Int
  cafe_id    Int
  image_url  String
  created_at DateTime? @default(now())
  
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cafe       cafes     @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
}
