generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cafes {
  id          Int     @id @default(autoincrement())
  name        String? @unique
  location    String?
  description String?
  image_url   String?
  products    products[]
}

model products {
  id          Int     @id @default(autoincrement())
  cafe_id     Int
  name        String
  price       String
  description String?
  image_url   String?
  
  cafe        cafes   @relation(fields: [cafe_id], references: [id], onDelete: Cascade)
}

model users {
  id         Int       @id @default(autoincrement())
  username   String
  email      String    @unique
  password   String
  created_at DateTime? @default(now())
}
